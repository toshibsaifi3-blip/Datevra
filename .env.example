# =====================================================================
# DATEVRA — environment template
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env` or any real keys to git.
# =====================================================================

# --- Supabase (required for production) ---
# Find these in the Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Use the PUBLISHABLE/ANON key only in the frontend.
# The SERVICE-ROLE key bypasses all Row Level Security — it must live
# ONLY in a server-side context (Supabase Edge Function / your server)
# and must NEVER be prefixed with VITE_ or shipped to the browser.

# --- Razorpay ---
# Publishable key id (safe for frontend). Use a TEST key until the
# business is ready for live payments.
VITE_RAZORPAY_KEY_ID=

# Keep "true" until live credentials are configured and the server-side
# verification endpoint + webhook are deployed. The app treats every
# payment as unverified until the server confirms it.
VITE_RAZORPAY_TEST_MODE=true

# RAZORPAY_KEY_SECRET (server-side only) — required for:
#   1. Creating orders server-side (Edge Function)
#   2. Verifying payment signatures
#   3. Handling webhooks (payment.captured, payment.failed, refunds)
# Store it in the Edge Function / server environment, never here.
